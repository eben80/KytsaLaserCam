# Place this 'map' block in the http context of nginx.conf
# (not in the server block)
#
# http {
#     map $http_upgrade $connection_upgrade {
#         default upgrade;
#         ''      close;
#     }
#     ...
# }

# HTTP server (now serving same content as HTTPS)
server {
    listen 80;
    server_name ebski.co www.ebski.co;

    root /var/www/ebski.co/html;
    index index.html index.php;

    error_log /var/www/ebski.co/error.log;
    access_log /var/www/ebski.co/access.log;

    location ^~ /kytsa/ {
        alias /var/www/ebski.co/kytsa_web_interface/;
        index index.html;
        try_files $uri $uri/ /kytsa/index.html;
    }

    location / {
        try_files $uri $uri/ /index.html /index.php?$args;
    }

    location = /receive {
        include fastcgi_params;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        fastcgi_param SCRIPT_FILENAME /var/www/ebski.co/php_backend/mjpeg_server.php;
        fastcgi_param REQUEST_URI /receive;
        proxy_buffering off;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        access_log off;
        fastcgi_buffering off;
        fastcgi_no_cache 1;
        fastcgi_keep_conn on;
    }

    location = /stream {
        include fastcgi_params;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        fastcgi_param SCRIPT_FILENAME /var/www/ebski.co/php_backend/mjpeg_server.php;
        fastcgi_param REQUEST_URI /stream;
        proxy_buffering off;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        fastcgi_buffering off;
        fastcgi_no_cache 1;
        fastcgi_keep_conn on;
    }

    location ~*  \.(jpg|jpeg|png|gif|ico|css|js|mp4)$ {
        expires 365d;
    }

    location /ws {
        proxy_pass http://localhost:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    error_page 404 /404.html;
    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    }

    location ~ /.well-known {
        allow all;
    }
}

# HTTPS server (unchanged)
server {
    listen 443 ssl http2;
    server_name ebski.co www.ebski.co;

    error_log /var/www/ebski.co/error.log;
    access_log /var/www/ebski.co/access.log;
    root /var/www/ebski.co/html;
    index index.html index.php;

    location ^~ /kytsa/ {
        alias /var/www/ebski.co/kytsa_web_interface/;
        index index.html;
        try_files $uri $uri/ /kytsa/index.html;
    }

    location / {
        try_files $uri $uri/ /index.html /index.php?$args;
    }

    location = /receive {
        include fastcgi_params;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        fastcgi_param SCRIPT_FILENAME /var/www/ebski.co/php_backend/mjpeg_server.php;
        fastcgi_param REQUEST_URI /receive;
        proxy_buffering off;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        access_log off;
        fastcgi_buffering off;
        fastcgi_no_cache 1;
        fastcgi_keep_conn on;
    }

    location = /stream {
        include fastcgi_params;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        fastcgi_param SCRIPT_FILENAME /var/www/ebski.co/php_backend/mjpeg_server.php;
        fastcgi_param REQUEST_URI /stream;
        proxy_buffering off;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        fastcgi_buffering off;
        fastcgi_no_cache 1;
        fastcgi_keep_conn on;
    }

    location ~*  \.(jpg|jpeg|png|gif|ico|css|js|mp4)$ {
        expires 365d;
    }

    location /ws {
        proxy_pass http://localhost:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    error_page 404 /404.html;
    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    }

    location ~ /.well-known {
        allow all;
    }

    ssl_certificate /etc/letsencrypt/live/ebski.co/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ebski.co/privkey.pem;
}
