# HTTPS server
#
server {
        listen 443 ssl http2;
        server_name ebski.co www.ebski.co;

	error_log /var/www/ebski.co/error.log;
	access_log /var/www/ebski.co/access.log;
        root /var/www/ebski.co/html;
        index index.php;

#    include snippets/ssl-ebski.co.conf;
#    include snippets/ssl-params.conf;
#	include global/restrictions.conf;
#	include global/wordpress.conf;


        location / {
                # First attempt to serve request as file, then
                # as directory, then fall back to displaying a 404.
                # try_files $uri $uri/ =404;
		try_files $uri $uri/ /index.php?$args;
                # Uncomment to enable naxsi on this location
                # include /etc/nginx/naxsi.rules

        }

    location = /receive {
        include fastcgi_params;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock; # Adjust PHP-FPM version
        fastcgi_param SCRIPT_FILENAME $document_root/mjpeg_server.php; # Directly point to the script
        # The SCRIPT_NAME will be /receive, and the PHP script will get it as $_SERVER['REQUEST_URI']
        fastcgi_param REQUEST_URI /receive; # Explicitly set REQUEST_URI if needed, though $fastcgi_script_name might pass it
	    # Disable buffering for streaming
    proxy_buffering off;
    proxy_http_version 1.1; # Often good for streaming
    proxy_set_header Connection ""; # Clear connection header if needed
	access_log off;
    # Or for fastcgi (more relevant here since it's PHP-FPM):
    fastcgi_buffering off;
    fastcgi_no_cache 1; # Don't cache responses
    fastcgi_keep_conn on; # Keep connection open
    }

    location = /stream {
        include fastcgi_params;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock; # Adjust PHP-FPM version
        fastcgi_param SCRIPT_FILENAME $document_root/mjpeg_server.php; # Directly point to the script
        fastcgi_param REQUEST_URI /stream; # Explicitly set REQUEST_URI if needed
    # Disable buffering for streaming
    proxy_buffering off;
    proxy_http_version 1.1; # Often good for streaming
    proxy_set_header Connection ""; # Clear connection header if needed
# access_log off;
    # Or for fastcgi (more relevant here since it's PHP-FPM):
    fastcgi_buffering off;
    fastcgi_no_cache 1; # Don't cache responses
    fastcgi_keep_conn on; # Keep connection open
    }

    		location ~*  \.(jpg|jpeg|png|gif|ico|css|js|mp4)$ {
        expires 365d;
    		}

        error_page 404 /404.html;
        error_page 500 502 503 504 /50x.html;
        location = /50x.html {
                root /usr/share/nginx/html;
        }

        location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        }

        location ~ /.well-known {
                allow all;
        }
    ssl_certificate /etc/letsencrypt/live/ebski.co/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/ebski.co/privkey.pem; # managed by Certbot



}

